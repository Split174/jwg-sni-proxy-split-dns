# Определялки IP
ipinfo.io ipwhois.io ifconfig.me ipify.org ip-api.com check-host.net {
    import common_config
    forward . 1.1.1.1 8.8.8.8
}

# Всё остальное перехватываем (VPN-туннель)
. {
    errors
    
    # 1. Отдаем IP туннеля/прокси для A-записей
    template IN A {
        match ".*"
        answer "{{ .Name }} 60 IN A 10.8.0.1"
    }
    
    # 2. Глушим IPv6 (чтобы трафик не утек мимо туннеля)
    template IN AAAA {
        match ".*"
        rcode NOERROR
    }

    # 3. Глушим всё остальное (HTTPS, TXT, MX), чтобы не было SERVFAIL на iOS/macOS
    template ANY ANY {
        match ".*"
        rcode NOERROR
    }
}
