# Глобальный блок (опционально, но полезно логировать ошибки)
(common_config) {
    errors
    cache 3600
}

ru xn--p1ai {
    import common_config
    # Если хотите зашифровать запросы от провайдера, раскомментируйте нижнюю строку и удалите обычный forward
    # forward . tls://1.1.1.1 tls://8.8.8.8 { tls_servername cloudflare-dns.com }
    forward . 1.1.1.1 8.8.8.8
}

